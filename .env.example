# Copier en .env à la racine (lu par docker compose) et dans apps/api/.env (lu par Django en local).

# --- API (Django) ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=postgis://wigo:wigo@localhost:5432/wigo
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=WIGO <no-reply@wigo.be>
EMAIL_URL=consolemail://
# Médias : local en dev, S3 compatible (Cloudflare R2) en prod
MEDIA_BACKEND=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=wigo-media

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL de l'API vue depuis le serveur Next (SSR) ; en compose : http://api:8000
API_URL=http://localhost:8000
